# Attenalyst identity
GROUP_NAME=My Member Group
GROUP_TIMEZONE=Asia/Singapore
MEMBER_ID_LABEL=matriculation number
SUPPORT_CONTACT=a group administrator

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Comma-separated numeric Telegram IDs. These accounts can administer the bot.
ADMIN_TELEGRAM_IDS=123456789
ALLOW_SELF_LINK=true

# Persistence
DATABASE_PATH=attenalyst.sqlite3

# Reminder policy (local time in GROUP_TIMEZONE)
QUIET_HOURS_START=22
QUIET_HOURS_END=9
REMINDER_INTERVAL_HOURS=12
REMINDER_CHECK_SECONDS=600
DEFAULT_RSVP_DEADLINE_HOURS=48

# Organizer website. Put the site behind HTTPS in production.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=replace-with-a-long-random-password
WEB_BASE_URL=http://localhost:8000
